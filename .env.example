# =============================================================================
#  DEVELOPMENT CREDENTIALS ONLY -- THIS FILE IS COMMITTED TO GIT.
#
#  Every value below is public. It is in the repository, in the git history, and
#  on GitHub. Treat all of it as already compromised, because it is.
#
#  These same values are the inline defaults in docker-compose.yml and the
#  Makefile, so a clean clone runs `make up && make seed && make test` with no
#  setup at all. That convenience is the ONLY thing they are for.
#
#  Nothing here is a production credential, and `make up` refuses to start when
#  ENV=production while any of these defaults are still in place. Copy this file
#  to .env (gitignored) to override locally.
# =============================================================================

# development | production. Anything other than "production" is treated as dev.
ENV=development

# ---- Postgres -------------------------------------------------------------
# POSTGRES_USER MUST stay krane_migrator. Item 02's migration hard-codes
# `ALTER DEFAULT PRIVILEGES FOR ROLE krane_migrator`; run the migrations as any
# other role and every future table reaches the API with no grants.
POSTGRES_USER=krane_migrator
POSTGRES_PASSWORD=dev_only_migrator
POSTGRES_DB=krane
POSTGRES_PORT=5432

# The throwaway database. `make test` drops and recreates it on every run, so
# never point this at anything you want to keep.
POSTGRES_TEST_DB=krane_test

# ---- Runtime role ---------------------------------------------------------
# The API's identity: no DDL rights, and read-only on role_permissions so it
# cannot rewrite the rules that govern it. Item 02 creates this role with LOGIN
# and NO password; the password is set from here by the app-role service,
# because a credential must never live inside a migration.
KRANE_APP_USER=krane_app
KRANE_APP_PASSWORD=dev_only_app

# ---- Mock OIDC issuer -----------------------------------------------------
# The API validates JWTs against this issuer's JWKS and never mints them.
# Pointing at a hosted issuer in production is a change to this one value.
OIDC_PORT=9090
